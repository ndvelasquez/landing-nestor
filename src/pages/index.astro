---
import Site from '../layouts/Site.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import BugReport from '../components/BugReport.astro';
import Icon from '../components/Icon.astro';

// Copy source: freelancer_project/content/landing-v3-copy.md (§14 decisions win).
const email = 'ndvelasquezl@gmail.com';
const linkedin = 'https://www.linkedin.com/in/nestor-david-velasquez/';
const upwork = 'https://www.upwork.com/freelancers/~01ed8af55d19c042d4';
const repo = 'https://github.com/ndvelasquez/n8n-ai-ticket-triage';
const loom = 'https://www.loom.com/share/c06880e29bb645e0bd553a7c55014862';
const mailTask = `mailto:${email}?subject=Task%20for%20Nestor`;
const calCall = 'https://cal.com/nestor-velasquez-ynlodg/15min';

const title = 'Nestor Velasquez | Technical Support, QA Testing & AI Evaluation';
const description =
  'Technical support, manual and game testing, AI evaluation and n8n/Zapier workflows, in English and Spanish. 6+ years in L2/L3 support. Remote from Panama.';

// Structured data: only verifiable facts. No reviews, ratings, address or clients.
const personId = new URL('/#nestor', Astro.site).href;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Nestor Velasquez',
  jobTitle: 'Technical Support, QA Testing and AI Evaluation',
  email: `mailto:${email}`,
  sameAs: [linkedin, upwork],
  knowsLanguage: ['en', 'es'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email,
    availableLanguage: ['en', 'es'],
  },
  knowsAbout: ['Technical support', 'Manual testing', 'Game testing', 'AI evaluation', 'Zendesk', 'Jira', 'REST APIs', 'n8n', 'Zapier', 'SQL'],
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'ProfessionalService',
      name: 'Fixed-price Zendesk work',
      serviceType: 'Zendesk routing, SLA rules, macros and ticket triage',
      url: new URL('/#zendesk', Astro.site).href,
      provider: { '@id': personId },
      areaServed: 'Worldwide',
      offers: [
        {
          '@type': 'Offer',
          name: 'Helpdesk Workflow Repair',
          description: 'One Zendesk routing or escalation workflow, built, tested and documented. Up to 6 hours, about one week.',
          priceSpecification: { '@type': 'PriceSpecification', minPrice: 250, priceCurrency: 'USD' },
        },
        {
          '@type': 'Offer',
          name: 'Ticket Triage Pilot',
          description: 'Ticket classification by intent, priority and language with routing decided by rules in code. Up to 10-12 hours, about two weeks.',
          priceSpecification: { '@type': 'PriceSpecification', minPrice: 550, priceCurrency: 'USD' },
        },
      ],
    },
  ],
};
---
<Site title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO: copy on ground, real demo output (H-3023) on the lime field -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero-title">I troubleshoot support tickets, test games and apps, and review AI output, <span class="mark"><span>in English and Spanish</span></span>.</h1>
    <div class="hero-copy">
      <p class="hero-sub">I've spent 6+ years in L2/L3 support for SaaS and API platforms, reproducing problems and handing them to engineering with the steps and logs they need. I take remote contracts, part-time roles and short tasks, and I also build Zapier and n8n workflows.</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={mailTask}><Icon name="mail" />Email me the task</a>
        <a class="btn btn-ghost" href={upwork} target="_blank" rel="noopener noreferrer">See my Upwork profile<Icon name="external" /><span class="visually-hidden"> (opens in a new tab)</span></a>
      </div>
      <p class="hero-foot">
        <a class="arrow-link" href="#proof">See work you can check <Icon name="arrow" /></a>
        <span class="hero-where">Based in Panama · Remote, UTC-5</span>
      </p>
    </div>
    <div class="hero-field on-field">
      <EvidenceCard />
    </div>
  </section>

  <!-- WORK: heading in the margin, one row per lane -->
  <section class="work" id="work" aria-labelledby="work-title">
    <div class="wrap work-grid">
      <div class="work-side">
        <h2 id="work-title" class="h2">What I take on</h2>
        <p class="work-intro">Four kinds of work, each with what backs it and what I haven't done yet.</p>
      </div>
      <div class="lanes">
        <article class="lane" aria-labelledby="lane-1">
          <h3 id="lane-1" class="lane-h">Technical support, tier 1 to 3</h3>
          <dl class="lane-facts">
            <div class="fact-situation"><dt>Your situation</dt><dd>Tickets come in English and Spanish, and some need someone who can read a log or test an API call before anything goes to engineering.</dd></div>
            <div><dt>What I do</dt><dd>I answer tickets by email or chat in both languages, reproduce the issue, and escalate it with steps, logs and context. I've worked in Zendesk (as admin), Jira and ServiceNow, and I write knowledge base articles so the same question stops coming back.</dd></div>
            <div><dt>What backs it</dt><dd>6+ years in L2/L3 support for SaaS and API platforms. 200+ enterprise accounts, around 40 critical incidents a month at 100% SLA, and 95% CSAT on a help desk queue.</dd></div>
          </dl>
        </article>

        <article class="lane" aria-labelledby="lane-2">
          <h3 id="lane-2" class="lane-h">Manual QA and game testing</h3>
          <div class="lane-body">
            <dl class="lane-facts">
              <div class="fact-situation"><dt>Your situation</dt><dd>You need a build tested on real hardware, and you want reports your developers can act on without asking three follow-up questions.</dd></div>
              <div><dt>What I do</dt><dd>Manual, exploratory and game testing on a gaming laptop (Windows), a Nintendo Switch, an iPhone 15 Pro Max and a Xiaomi 12T Pro (Android). Each report has steps, expected and actual result, device and OS version, frequency, and a screenshot or screen recording. I can test localized builds in English and Spanish.</dd></div>
              <div><dt>What backs it</dt><dd>Years of reproducing customer issues for engineering. Bugs I've caught include an Add button that returned a server error, pop-ups that opened with broken formatting, and content that showed on desktop but not on mobile. I play shooters, action/adventure, racing, sports and RPGs.</dd></div>
              <div class="fact-gap"><dt>What I haven't done</dt><dd>I haven't held a formal QA job.</dd></div>
            </dl>
            <BugReport />
          </div>
        </article>

        <article class="lane" aria-labelledby="lane-3">
          <h3 id="lane-3" class="lane-h">AI evaluation, language and audio tasks</h3>
          <dl class="lane-facts">
            <div class="fact-situation"><dt>Your situation</dt><dd>Your project needs someone to rate, rank or fact-check model answers in English or Spanish, or to work with audio and music.</dd></div>
            <div><dt>What I do</dt><dd>Response rating and ranking, fact-checking, writing and translation between English and Spanish, prompt writing, and audio or music evaluation.</dd></div>
            <div><dt>What backs it</dt><dd>C1 English (EF SET 76/100), native Spanish, and an associate degree in computer science (2016). For my n8n demo I wrote 25 held-out test tickets and 8 adversarial ones (prompt injections, mixed intent) before any run, then checked the model's answers against my labels. I play guitar, piano and bass, transcribe audio to sheet music, and record demo tracks in Reaper, Cubase and Cakewalk.</dd></div>
            <div class="fact-gap"><dt>What I haven't done</dt><dd>I'm new to annotation platforms. Send me the guidelines and a sample task, and I'll tell you if anything is unclear before I start.</dd></div>
          </dl>
        </article>

        <article class="lane" aria-labelledby="lane-4">
          <h3 id="lane-4" class="lane-h">Zendesk and automation</h3>
          <dl class="lane-facts">
            <div class="fact-situation"><dt>Your situation</dt><dd>Someone on your team copies data between tools by hand, or your Zendesk routing, SLA rules and macros grew out of control.</dd></div>
            <div><dt>What I do</dt><dd>Zendesk admin work (triggers, macros, views, SLA policies, auto-assignment), Zapier and n8n workflows, REST API and webhook troubleshooting with Postman, and SQL checks.</dd></div>
            <div><dt>What backs it</dt><dd>I built Zapier and n8n workflows that cut manual support work by about 70%, and wrote playbooks and documentation that cut response times by 50%. Both demos below are in this lane.</dd></div>
          </dl>
          <a class="arrow-link lane-link" href="#zendesk">Fixed-price Zendesk work <Icon name="arrow" /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- PROOF: heading row, then the triage demo with the field on the left -->
  <section class="proof" id="proof" aria-labelledby="proof-title">
    <div class="wrap proof-head">
      <h2 id="proof-title" class="h2">Work you can check</h2>
      <p class="proof-intro">Two projects I built and tested myself, both public. Both are synthetic demos, so the tickets, the store and the labels are mine.</p>
    </div>

    <div class="triage">
      <div class="triage-field on-field">
        <div class="card triage-card">
          <p class="triage-label">Synthetic demo; not a client project.</p>
          <table class="data-table">
            <caption class="visually-hidden">Triage demo results on the held-out set</caption>
            <thead>
              <tr><th scope="col">Held-out set, 25 tickets</th><th scope="col">Result</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">Category correct</th><td>24 of 25</td></tr>
              <tr><th scope="row">Auto-routed tickets with the right category</th><td>17 of 17</td></tr>
              <tr><th scope="row">Sent to human review</th><td>8 of 25</td></tr>
              <tr><th scope="row">Injected instructions followed</th><td>0 of 2</td></tr>
              <tr><th scope="row">Priority correct</th><td>23 of 25</td></tr>
            </tbody>
          </table>
          <p class="triage-caveats">I wrote and labeled every ticket. Each number is one run, and results vary between runs. 7 of the 8 tickets sent to review already had the right category, so the flow sends more to people than it needs to.</p>
        </div>
      </div>
      <div class="triage-copy">
        <h3 class="proj-h">AI ticket triage in n8n</h3>
        <p>An n8n flow reads a support ticket and asks an LLM for a category and priority, with a quote from the ticket as evidence. Code checks the quote and the confidence, then picks the queue. Tickets the flow is unsure about go to a person.</p>
        <div class="proj-links">
          <a class="btn btn-primary" href="/work/ai-ticket-triage#try">Try it live</a>
          <a class="arrow-link" href="/work/ai-ticket-triage">Read the case study <Icon name="arrow" /></a>
          <a class="arrow-link" href={repo} rel="noopener noreferrer" target="_blank">Code on GitHub <Icon name="external" /><span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
      </div>
    </div>

    <!-- Brightwick: quiet, on ground (one field per viewport); before/after as a hairline table -->
    <div class="wrap bw">
      <div class="bw-copy">
        <p class="bw-tag">Synthetic demo; not a client project.</p>
        <h3 class="proj-h">Zendesk routing audit and repair (Brightwick)</h3>
        <p>I set up a Zendesk trial badly on purpose for a fictional store: all 25 test tickets landed in one group, 3 triggers fought over priority, and 13 macros overlapped. I wrote 8 acceptance tests before changing anything.</p>
        <p class="bw-result">Run 1 failed and found 3 bugs in my setup. Run 2 passed <span class="mark">8 of 8</span>.</p>
        <p class="bw-limit">The keyword priority rule is crude. Against my labels it raised 3 of the 5 urgent tickets and missed two.</p>
        <ul class="bw-links">
          <li><a class="arrow-link" href="/work/zendesk-workflow-repair">Read the audit <Icon name="arrow" /></a></li>
          <li><a class="arrow-link" href={loom} rel="noopener noreferrer" target="_blank">Watch the walkthrough (4:40) <Icon name="external" /><span class="visually-hidden"> (opens in a new tab)</span></a></li>
          <li><a class="arrow-link" href="/work/brightwick-zendesk-audit-mobile.pdf">Mobile PDF <Icon name="arrow" /></a></li>
        </ul>
      </div>
      <table class="ba">
        <caption class="visually-hidden">Brightwick Zendesk setup before and after the repair</caption>
        <thead><tr><th scope="col">Before</th><th scope="col">After</th></tr></thead>
        <tbody>
          <tr><td>1 group for every ticket</td><td>4 groups, 7 routing triggers</td></tr>
          <tr><td>3 triggers rewriting priority</td><td>1 priority trigger</td></tr>
          <tr><td>1 SLA target (normal, 1 h)</td><td>First reply by priority: 1, 4, 8 and 24 h</td></tr>
          <tr><td>13 macros</td><td>6 macros, 3 views</td></tr>
        </tbody>
      </table>
    </div>

    <div class="wrap past">
      <h3 class="past-h">From past roles</h3>
      <ul class="dash-list past-list">
        <li>200+ enterprise accounts supported on a SaaS and API platform</li>
        <li>Around 40 critical incidents a month, handled at 100% SLA</li>
        <li>95% CSAT on a help desk queue</li>
        <li>About 70% less manual support work after a Zapier and n8n automation</li>
      </ul>
    </div>
  </section>

  <!-- SKILLS: heading alone on top, four text columns -->
  <section class="skills" id="skills" aria-labelledby="skills-title">
    <div class="wrap">
      <h2 id="skills-title" class="h2 skills-h">Skills and tools</h2>
      <div class="skill-cols">
        <div class="skill">
          <h3>Support and help desk</h3>
          <p>Zendesk (admin), Jira, ServiceNow, knowledge base writing, ticket escalation, SSO troubleshooting, AnyDesk, Slack, Google Workspace (admin)</p>
        </div>
        <div class="skill">
          <h3>Testing</h3>
          <p>Manual, exploratory and game testing, bug reports, localization checks in English and Spanish, Jira</p>
          <p class="skill-devices"><span class="skill-label">Devices</span> gaming laptop (ASUS TUF Gaming F15, Windows), Nintendo Switch, iPhone 15 Pro Max (iOS 26), Xiaomi 12T Pro (Android 13)</p>
        </div>
        <div class="skill">
          <h3>AI, language and audio</h3>
          <p>Response rating and fact-checking, prompt writing, LLM test sets, English (C1, EF SET 76/100), Spanish (native), English to Spanish translation, guitar, piano and bass, audio to sheet music, Reaper, Cubase, Cakewalk</p>
        </div>
        <div class="skill">
          <h3>Automation and data</h3>
          <p>Zapier, n8n, REST APIs, webhooks, Postman, SQL, AWS (S3, Lambda, Athena), New Relic, Coralogix, Splunk, Grafana</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ZENDESK: heading row with intro, two offers split by a hairline, the only Cal.com button -->
  <section class="offers" id="zendesk" aria-labelledby="offers-title">
    <div class="wrap">
      <div class="offers-head">
        <h2 id="offers-title" class="h2">Fixed-price Zendesk work</h2>
        <p class="offers-intro">If your Zendesk is the problem, I also sell two fixed-scope projects. Intro prices for my first three clients.</p>
      </div>

      <div class="offers-grid">
        <article class="offer">
          <h3 class="offer-name">Helpdesk Workflow Repair</h3>
          <p class="offer-price">Fixed price, <span class="mark nowrap">from $250</span></p>
          <p class="offer-for">For one routing or escalation problem you can name.</p>
          <ul class="dash-list offer-list">
            <li>A review of the triggers, views, macros and SLA rules involved</li>
            <li>One routing or escalation workflow, built and tested against pass/fail checks we agree first</li>
            <li>Up to three supporting macros or views</li>
            <li>A recorded walkthrough and handover notes</li>
          </ul>
          <p class="offer-scope">One Zendesk instance, up to 6 hours of work including testing and documentation, about one week. If the problem doesn't fit in 6 hours, I tell you before we start.</p>
          <a class="arrow-link offer-case" href="/work/zendesk-workflow-repair">See a sample repair: the Brightwick audit <Icon name="arrow" /></a>
        </article>

        <article class="offer">
          <h3 class="offer-name">Ticket Triage Pilot</h3>
          <p class="offer-price">Fixed price, <span class="mark nowrap">from $550</span></p>
          <p class="offer-for">For teams whose ticket categories don't fit native Zendesk rules or built-in AI.</p>
          <ul class="dash-list offer-list">
            <li>New tickets classified by intent, priority and language, using your own list of up to 8 categories</li>
            <li>Routing decided by rules in code, plus a Slack alert for the tickets you define as urgent</li>
            <li>An accuracy check on a redacted sample of your tickets, with pass criteria agreed before we start</li>
            <li>Documentation and a walkthrough</li>
          </ul>
          <p class="offer-scope">One helpdesk, one Slack channel, up to 10-12 hours of work, about two weeks. Built with n8n or Zapier and an LLM API (you pay the API costs). There's no accuracy guarantee, and if native rules are enough for your case, I'll say so before you buy this.</p>
        </article>
      </div>

      <div class="offers-foot">
        <div class="offers-notes">
          <p>I work in a sandbox, with temporary access, or on a screen-share where you drive. Nothing changes in production without your approval and a rollback plan.</p>
          <p class="offers-excl">Not included: chatbots, chat or messaging integrations, migrations, ongoing monitoring, and software or API costs.</p>
        </div>
        <div class="offers-cta">
          <a class="btn btn-primary" href={calCall} target="_blank" rel="noopener noreferrer"><Icon name="calendar" />Book a 15-min Zendesk call<span class="visually-hidden"> (opens in a new tab)</span></a>
          <p class="offers-bring">Bring your Zendesk plan, your monthly ticket volume and the one thing in the queue you'd fix first.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT: offset reading column -->
  <section class="about" id="about" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <div class="about-col">
        <h2 id="about-title" class="about-h">About me</h2>
        <p class="lead">I'm Nestor Velasquez. I've worked in technical support since 2019, first on an IT help desk and then in L2/L3 support for SaaS and API platforms.</p>
        <p>Most days the job was the same: take a problem a customer couldn't describe well, reproduce it, find where it broke, and hand it to engineering with what they needed to fix it. Along the way I administered Zendesk, ran incident work in Jira, built automations in Zapier and n8n, and checked data with SQL. That habit of reproducing and writing up a problem is what I bring to testing and AI evaluation.</p>
        <p>I hold an associate degree in computer science (2016). I speak native Spanish and C1 English, and I play guitar, piano and bass. I live in Panama and work remotely on UTC-5.</p>
      </div>
    </div>
  </section>

  <!-- QUESTIONS: heading in the margin, questions as a list -->
  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <h2 id="faq-title" class="h2 faq-h">Questions</h2>
      <div class="faq-list">
        <div class="qa">
          <h3>Have you worked as a QA tester before?</h3>
          <p>Not in a formal QA role. I've reproduced and documented bugs for engineering for 6+ years as an L2/L3 support analyst, and the sample bug report on this page shows the format I use.</p>
        </div>
        <div class="qa">
          <h3>Have you done annotation or AI training work?</h3>
          <p>Not on a platform yet. I've written LLM test sets and checked a model's answers against my own labels for my n8n demo. Send me the guidelines and a sample task and I'll tell you if anything is unclear before I start.</p>
        </div>
        <div class="qa">
          <h3>How do I pay you?</h3>
          <p>Through Upwork or Contra, or by direct invoice paid with Payoneer, Wise or PayPal.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT: the field returns at page scale -->
  <section class="contact on-field" id="contact" aria-labelledby="contact-title">
    <div class="wrap contact-grid">
      <h2 id="contact-title" class="contact-h">Send me the task</h2>
      <div class="contact-body">
        <p class="lead">Tell me what the work is, which tools or devices it uses, and how many hours you need. I'll reply with whether I'm a fit and what I'd check first. English or Spanish both work.</p>
        <a class="btn btn-primary contact-cta" href={mailTask}><Icon name="mail" />Email me the task</a>
        <dl class="contact-list">
          <div>
            <dt>Email</dt>
            <dd><a class="contact-li" href={mailTask}><Icon name="mail" />{email}</a></dd>
          </div>
          <div>
            <dt>Upwork</dt>
            <dd><a class="contact-li" href={upwork} target="_blank" rel="noopener noreferrer"><Icon name="external" />upwork.com/freelancers/~01ed8af55d19c042d4<span class="visually-hidden"> (opens in a new tab)</span></a></dd>
          </div>
          <div>
            <dt>LinkedIn</dt>
            <dd><a class="contact-li" href={linkedin} rel="me noopener" target="_blank"><Icon name="linkedin" />linkedin.com/in/nestor-david-velasquez<span class="visually-hidden"> (opens in a new tab)</span></a></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Site>

<style>
  .nowrap { white-space: nowrap; }
  .btn :global(svg), .arrow-link :global(svg) { flex: none; }

  /* ---------------- HERO ---------------- */
  .hero {
    display: grid;
    grid-template-columns: var(--split);
    grid-template-rows: minmax(calc(var(--header-h) + var(--space-6)), 1fr) auto auto minmax(var(--space-7), 1fr);
    grid-template-areas: ". field" "title field" "copy field" ". field";
    min-height: min(100svh, var(--hero-max));
  }
  .hero-title {
    grid-area: title;
    padding-inline: var(--gutter);
    font-size: var(--type-hero);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: calc(19ch + 2 * var(--gutter));
  }
  .hero-copy { grid-area: copy; padding-inline: var(--gutter); }
  .hero-sub { margin-top: var(--space-6); font-size: var(--type-lead); line-height: var(--leading-relaxed); max-width: 46ch; color: var(--color-ink-2); }
  .hero-ctas { margin-top: var(--space-6); display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .hero-foot {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
    max-width: 52ch;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 0 var(--space-5);
  }
  .hero-where { font-size: var(--type-small); color: var(--color-ink-2); }
  .hero-field {
    grid-area: field;
    background: var(--color-field);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--header-h) + var(--space-6)) var(--gutter) var(--space-8) var(--space-7);
  }

  /* ---------------- WORK ---------------- */
  .work { padding-block: var(--space-9) var(--rhythm-5); }
  .work-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-7); align-items: start; }
  .work-side { position: sticky; top: var(--space-6); }
  .work-side .h2 { max-width: 9ch; }
  .work-intro { margin-top: var(--space-5); color: var(--color-ink-2); max-width: 30ch; }
  .lanes { border-bottom: 1px solid var(--color-rule); }
  .lane {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 7fr);
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-6) var(--space-7);
    border-top: 1.5px solid var(--color-ink);
  }
  .lane-h { font-size: var(--type-h3-lg); line-height: var(--leading-tight); letter-spacing: -0.02em; }
  .lane-facts { display: grid; gap: var(--space-4); max-width: 60ch; }
  .lane-facts dt { font-size: var(--type-label); line-height: var(--leading-small); font-weight: 600; color: var(--color-ink-2); }
  .lane-facts dd { margin: var(--space-1) 0 0; }
  .fact-situation dd { font-size: var(--type-lead); line-height: var(--leading-relaxed); }
  .fact-gap { padding-top: var(--space-3); border-top: 1px solid var(--color-rule); }
  .lane-body { display: grid; gap: var(--space-7); }
  .lane-link { grid-column: 2; margin-top: var(--space-1); }

  /* ---------------- PROOF ---------------- */
  .proof { padding-top: var(--rhythm-3); border-top: 1px solid var(--color-rule); }
  .proof-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--space-5) var(--space-7); align-items: end; padding-bottom: var(--space-8); }
